# Dependencies
# It's better to let users install their own dependencies
/vendor/

# Configuration and Environment
# Never share your local configuration or secrets
.env
.env.backup
.phpunit.result.cache

# Composer Lock File
# For packages/libraries, it is standard practice to ignore composer.lock 
# to allow users to get the latest compatible versions.
composer.lock

# IDE and Editors
# Editor-specific settings that shouldn't be in the repository
.idea/
.vscode/
*.swp
*.bak

# Operating System Files
# Junk files generated by the OS
.DS_Store
Thumbs.db

# Testing and Coverage
# Test outputs and cache
/tests/_output/
/tests/_support/_generated/
/build/